{%
	import { stat } from 'fs';

	// Live A8 web updates do not change the installed package database timestamp.
	const a8_ui_version = max(
		stat('/usr/share/luci/menu.d/a8-apn.json')?.mtime ?? 0,
		stat('/www/luci-static/resources/a8-ims.js')?.mtime ?? 0,
		stat('/www/luci-static/resources/view/modemmanager/status.js')?.mtime ?? 0
	);
	include(`themes/${theme}/header`);
-%}

<script src="{{ resource }}/luci.js?v=26.304.26398~e969939-{{ pkgs_update_time }}-{{ a8_ui_version }}"></script>
<script>
	L = new LuCI({{ replace(`${ {
		media          : media,
		resource       : resource,
		scriptname     : http.getenv("SCRIPT_NAME"),
		pathinfo       : http.getenv("PATH_INFO"),
		documentroot   : http.getenv("DOCUMENT_ROOT"),
		requestpath    : ctx.request_path,
		dispatchpath   : ctx.path,
		pollinterval   : +config.main.pollinterval || 5,
		ubuspath       : config.main.ubuspath || '/ubus/',
		sessionid      : ctx.authsession,
		token          : ctx.authtoken,
		nodespec       : dispatched,
		apply_rollback : max(+config.apply.rollback ||  90, 90),
		apply_holdoff  : max(+config.apply.holdoff  ||   4,  1),
		apply_timeout  : max(+config.apply.timeout  ||   5,  1),
		apply_display  : max(+config.apply.display  || 1.5,  1),
		rollback_token : rollback_token
	} }`, '/', '\\/') }});
	L.require('session').then(function(session) {
		if (session.getLocalData('ui-resource-version') !== L.env.resource_version) {
			session.setLocalData('menu', null);
			session.setLocalData('ui-resource-version', L.env.resource_version);
		}
	});
</script>
