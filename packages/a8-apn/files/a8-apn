#!/usr/bin/lua
local json = require('luci.jsonc')
if arg[1] == 'ims-status' then
    print(json.stringify(require('a8_apn.ims').status()))
elseif arg[1] == 'status' then
    local service = require('a8_apn.service')
    print(json.stringify((service.inspect())))
elseif arg[1] == 'apply' then
    print(json.stringify(require('a8_apn.service').apply()))
else
    io.stderr:write('Usage: a8-apn {status|apply|ims-status}\n'); os.exit(1)
end
