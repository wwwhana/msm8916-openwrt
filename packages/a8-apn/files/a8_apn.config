config settings 'settings'
	option enabled '1'
	option mode 'auto'
	option interface 'modem'
	option iptype 'profile'
	option allow_roaming '0'
	option radio_mode 'keep'
	option database_profile 'auto'
	option profile 'custom'

config profile 'custom'
	option enabled '1'
	option name 'Custom'
	option apn ''
	option auth 'none'
	option iptype 'ipv4v6'
