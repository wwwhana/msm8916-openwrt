From: OpenWrt A8 port
Subject: [PATCH] adbd: Linux FunctionFS, musl reconnects and USB-only transport

Adapted from dikeckaan/mu300-linux commit
833616a6c03a7c0245300c5946d98ec98b09bb94 (MIT; LICENSE.mu300).
AOSP source files retain their Apache-2.0 licenses.

--- a/vendor/adb/daemon/main.cpp
+++ b/vendor/adb/daemon/main.cpp
@@ -194,7 +194,12 @@
 }

 int adbd_main(int server_port) {
+#if defined(__ANDROID__)
     umask(0);
+#else
+    // OpenWrt Linux: the shells and the files of a root daemon are not world-writable
+    umask(022);
+#endif

     signal(SIGPIPE, SIG_IGN);

@@ -209,7 +214,9 @@

     // We need to call this even if auth isn't enabled because the file
     // descriptor will always be open.
+#if defined(__ANDROID__)
     adbd_cloexec_auth_socket();
+#endif

 #if defined(__ANDROID__)
     bool device_unlocked = android::base::GetProperty("ro.boot.verifiedbootstate", "") == "orange";
@@ -225,6 +232,15 @@
         auth_required = android::base::GetBoolProperty("ro.adb.secure", false);
 #endif
     }
+#else
+    // Linux: the USB gadget service selects open or public-key authentication.
+    // OPENWRT_ADB_AUTH=open is Android's ro.adb.secure=0: every computer on the USB cable is accepted without a
+    // key and gets a root shell. Anything
+    // else, including a missing variable, accepts only a key in /etc/adb/adb_keys or
+    // /root/.android/adb_keys gets in. No property and no option does the same.
+    const char* mu300_adb_auth = getenv("OPENWRT_ADB_AUTH");
+    auth_required = !(mu300_adb_auth != nullptr && std::string(mu300_adb_auth) == "open");
+    LOG(INFO) << "authentication: " << (auth_required ? "keys" : "open (every computer is accepted)");
 #endif

     // Our external storage path may be different than apps, since
@@ -252,13 +268,23 @@

     bool is_usb = false;

-#if defined(__ANDROID__)
+#if defined(__linux__)
     if (access(USB_FFS_ADB_EP0, F_OK) == 0) {
         // Listen on USB.
         usb_init();
         is_usb = true;
     }
 #endif
+
+#if !defined(__ANDROID__)
+    // OpenWrt Linux: USB only. No TCP or vsock listener, whatever the properties or the environment say: the
+    // device's LAN and Wi-Fi clients must never reach a root shell.
+    if (!is_usb) {
+        LOG(ERROR) << "no FunctionFS at " << USB_FFS_ADB_EP0 << " (usb-gadget sets it up)";
+        return 1;
+    }
+    (void)setup_adb;
+#else

     // If one of these properties is set, also listen on that port.
     // If one of the properties isn't set and we couldn't listen on usb, listen
@@ -296,6 +322,7 @@
         addrs = android::base::Split(prop_addr, ",");
         setup_adb(addrs);
     }
+#endif

     LOG(INFO) << "adbd started";

