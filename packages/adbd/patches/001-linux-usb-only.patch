@@ -401,6 +407,13 @@
         CHECK(!worker_started_);
         worker_started_ = true;
         worker_thread_ = std::thread([this]() {
+            // OpenWrt Linux: say when this thread is done. StopWorker waited for pthread_kill(t, 0) to fail with
+            // ESRCH, which musl never does for a thread that has exited but is not joined yet: adbd hung for good
+            // at the end of every USB connection (an unbind, a computer that unplugs).
+            struct ExitFlag {
+                std::atomic<bool>* f;
+                ~ExitFlag() { *f = true; }
+            } exit_flag{&worker_exited_};
             adb_thread_setname("UsbFfs-worker");
             LOG(INFO) << "UsbFfs-worker thread spawned";

