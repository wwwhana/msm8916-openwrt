#!/bin/sh /etc/rc.common
# Started by usb-gadget after mounting FunctionFS; no independent boot order.
USE_PROCD=1

start_service() {
	local enabled auth
	config_load usbgadget
	config_get_bool enabled adb enabled 0
	[ "$enabled" = 1 ] && [ -e /dev/usb-ffs/adb/ep0 ] || return 1
	config_get auth adb auth keys
	[ "$auth" = open ] || auth=keys
	procd_open_instance daemon
	procd_set_param command /usr/sbin/adbd
	procd_set_param env OPENWRT_ADB_AUTH="$auth"
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance reconnect
	procd_set_param command /usr/sbin/usb-gadget watch-adb
	procd_set_param respawn 3600 2 0
	procd_set_param stderr 1
	procd_close_instance
}
