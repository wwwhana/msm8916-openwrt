#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=98
STOP=10
USE_PROCD=1

start_service() {
	local enabled bridge
	config_load bt-nap
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get bridge main bridge br-lan
	case "$bridge" in ''|*[!a-zA-Z0-9_.-]*) return 1 ;; esac
	[ -d "/sys/class/net/$bridge/bridge" ] || return 1
	procd_open_instance
	procd_set_param command /usr/bin/bt-network --server nap "$bridge"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger bt-nap
	procd_add_interface_trigger 'interface.*.up' lan /etc/init.d/bt-nap restart
}
