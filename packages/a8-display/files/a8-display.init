#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=12
USE_PROCD=1

boot() {
	start boot
}

start_service() {
	tr '\000' '\n' < /proc/device-tree/compatible | grep -qEx 'mifib-v18,generic|jz08c-v50,generic' || return 0
	/usr/libexec/a8-device lcd-enabled || return 0
	procd_open_instance
	if [ "$1" = boot ]; then procd_set_param command /usr/sbin/a8-display --boot
	else procd_set_param command /usr/sbin/a8-display; fi
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_set_param file /etc/config/a8_device
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger a8_device
}
