#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=98
USE_PROCD=1

start_service() {
	tr '\000' '\n' < /proc/device-tree/compatible | grep -qx 'mifib-v18,generic' || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/a8-display
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}
