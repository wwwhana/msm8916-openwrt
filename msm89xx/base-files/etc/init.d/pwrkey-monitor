#!/bin/sh /etc/rc.common
USE_PROCD=1
START=94
STOP=02

a8_menu() {
    [ -x /usr/libexec/a8-menu ] &&
        tr '\000' '\n' < /proc/device-tree/compatible | grep -qx 'mifib-v18,generic'
}

start_service() {
    local command=/sbin/pwrkey-monitor
    # One reader routes KEY_POWER to either the LCD or the original handler.
    if a8_menu; then
        command=/usr/libexec/a8-menu
    fi
    procd_open_instance
    procd_set_param command "$command"
    [ "$command" != /usr/libexec/a8-menu ] || procd_set_param file /etc/config/a8_device
    procd_set_param respawn
    procd_close_instance
}

service_triggers() {
    if a8_menu; then procd_add_reload_trigger a8_device; fi
}
