 normal_boot:
+#if A8_LCD_RAM_TEST
+	/* Even a forced-reset shortcut must reach USB without touching the LCD. */
+	boot_into_fastboot = true;
+#elif A8_ONE_BUTTON_MENU
+	/* Recovery owns its LCD; rescue entry must bypass the boot LCD driver. */
+	if (!boot_into_recovery && !boot_into_fastboot) {
+		enum a8_boot_choice choice = a8_boot_menu();
+		if (choice == A8_RECOVERY) boot_into_recovery = 1;
+		else if (choice == A8_FASTBOOT) boot_into_fastboot = true;
+		else if (choice == A8_EDL) {
+			reboot_device(EMERGENCY_DLOAD);
+			boot_into_fastboot = true;
+		}
+	}
+#endif
 	if (!boot_into_fastboot)
