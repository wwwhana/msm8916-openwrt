+package sms
+
+import "errors"
+
+// EncodeNASSubmit reuses the IMS TPDU codec inside a QMI 3GPP SMS PDU.
+// An empty SMSC address selects EF-SMSP. LMS is handled by MMS, not truncation.
+func EncodeNASSubmit(reference byte, to, text string) ([]byte, error) {
+    parts, err := buildUserDataParts(text)
+    if err != nil { return nil, err }
+    if len(parts) != 1 { return nil, errors.New("NAS SMS requires one segment") }
+    tpdu, err := newSubmitTPDU(submitTPDUConfig{
+        Reference:reference, Destination:to, Part:parts[0],
+        RejectDuplicates:true, RequestStatusReport:true,
+    }).MarshalBinary()
+    if err != nil { return nil, err }
+    return append([]byte{0}, tpdu...), nil
+}
+
+// DecodeNASMessage separates the SMSC envelope before using the same text,
+// binary/UDH and status-report parsers as SMS over IMS.
+func DecodeNASMessage(data []byte) (Incoming, *StatusReport, error) {
+    center, consumed, err := decodeRPAddress(data)
+    if err != nil { return Incoming{}, nil, err }
+    tpdu := data[consumed:]
+    kind, err := tpduMessageType(tpdu)
+    if err != nil { return Incoming{}, nil, err }
+    switch kind {
+    case tpduMTIDeliver, tpduMTIReserved:
+        message, err := decodeDeliver(tpdu)
+        message.ServiceCenter = center
+        return message, nil, err
+    case tpduMTIStatusReport:
+        report, err := decodeStatusReport(tpdu)
+        report.ServiceCenter = center
+        return Incoming{}, &report, err
+    default:
+        return Incoming{}, nil, errors.New("unsupported mobile-terminated NAS TPDU")
+    }
+}
