+
+// Carrier-provisioned AKA without SIP IPsec is separate from algorithm fallback.
+// A server security requirement still fails instead of being silently ignored.
+func (s *Registrar) parseRegisterChallenge(resp sip.Message, offered security.Params, requiredMode string) (registerAuthChallenge, error) {
+	if !s.cfg.DisableIPSec {
+		return parseRegisterChallenge(resp, offered, requiredMode)
+	}
+	if resp.Headers.Has("Security-Server") || resp.HeaderHasToken("Require", "sec-agree") || resp.HeaderHasToken("Proxy-Require", "sec-agree") {
+		return registerAuthChallenge{}, errors.New("carrier policy conflicts with server security agreement")
+	}
+	parsed, err := selectRegisterChallengeForResponse(resp)
+	if err != nil {
+		return registerAuthChallenge{}, err
+	}
+	if parsed.challenge.Algorithm != security.AlgorithmAKAv1MD5 {
+		return registerAuthChallenge{}, errors.New("carrier policy requires AKAv1-MD5")
+	}
+	return parsed, nil
 }
 
